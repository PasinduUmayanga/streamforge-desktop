<Page
    x:Class="StreamForge.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StreamForge.App.Converters"
    xmlns:models="using:StreamForge.Core.Models">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentContainer.Padding" Value="12" />
                        <Setter Target="WizardStepGrid.ColumnSpacing" Value="4" />
                        <Setter Target="AnalysisProgressColumn0.Width" Value="*" />
                        <Setter Target="AnalysisProgressColumn1.Width" Value="0" />
                        <Setter Target="AnalysisStepsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="AnalysisStepsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="NetworkCallsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="NetworkCallsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="NetworkActivityBorder.Height" Value="260" />
                        <Setter Target="ActionColumn0.Width" Value="*" />
                        <Setter Target="ActionColumn1.Width" Value="0" />
                        <Setter Target="ActionColumn2.Width" Value="0" />
                        <Setter Target="ActionColumn3.Width" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Row)" Value="1" />
                        <Setter Target="PauseButton.(Grid.Column)" Value="0" />
                        <Setter Target="ResumeButton.(Grid.Row)" Value="2" />
                        <Setter Target="ResumeButton.(Grid.Column)" Value="0" />
                        <Setter Target="CancelButton.(Grid.Row)" Value="3" />
                        <Setter Target="CancelButton.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentContainer.Padding" Value="28" />
                        <Setter Target="WizardStepGrid.ColumnSpacing" Value="8" />
                        <Setter Target="AnalysisProgressColumn0.Width" Value="*" />
                        <Setter Target="AnalysisProgressColumn1.Width" Value="*" />
                        <Setter Target="AnalysisStepsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="AnalysisStepsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="NetworkCallsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="NetworkCallsPanel.(Grid.Column)" Value="1" />
                        <Setter Target="NetworkActivityBorder.Height" Value="420" />
                        <Setter Target="ActionColumn0.Width" Value="*" />
                        <Setter Target="ActionColumn1.Width" Value="*" />
                        <Setter Target="ActionColumn2.Width" Value="*" />
                        <Setter Target="ActionColumn3.Width" Value="*" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Row)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Column)" Value="1" />
                        <Setter Target="ResumeButton.(Grid.Row)" Value="0" />
                        <Setter Target="ResumeButton.(Grid.Column)" Value="2" />
                        <Setter Target="CancelButton.(Grid.Row)" Value="0" />
                        <Setter Target="CancelButton.(Grid.Column)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalContentAlignment="Top"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <Grid
                x:Name="ContentContainer"
                Width="{Binding ElementName=PageScrollViewer, Path=ViewportWidth}"
                MaxWidth="1180"
                Padding="28"
                HorizontalAlignment="Center"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock FontSize="32" FontWeight="SemiBold" Text="StreamForge" />
                    <TextBlock
                        Opacity="0.75"
                        Text="Step through stream detection, analysis, selection, and FFmpeg download."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    x:Name="WizardStepGrid"
                    Grid.Row="1"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding GoToAnalyzeStepCommand}"
                        Content="1  Setup"
                        IsEnabled="{Binding CanGoToAnalyzeStep}" />
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Content="2  Analysis"
                        IsEnabled="False" />
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding GoToStreamStepCommand}"
                        Content="3  Select stream"
                        IsEnabled="{Binding CanGoToStreamStep}" />
                    <Button
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        Command="{Binding GoToDownloadStepCommand}"
                        Content="4  Download options"
                        IsEnabled="{Binding CanGoToDownloadStep}" />
                    <Button
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding GoToDownloadProgressStepCommand}"
                        Content="5  Progress"
                        IsEnabled="{Binding CanGoToDownloadProgressStep}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel
                            Spacing="12"
                            Visibility="{Binding IsAnalyzeStepActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Step 1: Setup" />
                            <TextBlock Text="Video page or direct media URL" />
                            <TextBox
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanEditPageUrl}"
                                PlaceholderText="https://example.com/video/123 or https://cdn.example.com/master.m3u8"
                                Text="{Binding PageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Expander Header="Optional local AI diagnostics">
                                <StackPanel Spacing="8">
                                    <CheckBox
                                        Content="Use local AI diagnostics when normal detection fails"
                                        IsEnabled="{Binding CanEditPageUrl}"
                                        IsChecked="{Binding UseLocalAiAdvisor, Mode=TwoWay}" />
                                    <TextBlock
                                        Opacity="0.7"
                                        Text="Only sanitized response structure is sent to the loopback Qwen/Ollama worker; every suggestion is verified before use."
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="Local endpoint" />
                                    <TextBox
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding CanEditAiSettings}"
                                        Text="{Binding LocalAiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Installed model" />
                                    <TextBox
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding CanEditAiSettings}"
                                        Text="{Binding LocalAiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Expander>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding AnalyzeCommand}"
                                    Content="Start analysis"
                                    IsEnabled="{Binding CanAnalyze}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            Spacing="12"
                            Visibility="{Binding IsAnalysisProgressStepActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Step 2: Analysis" />
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ProgressRing
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    IsActive="{Binding IsAnalyzing}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding CancelCommand}"
                                    Content="Cancel"
                                    IsEnabled="{Binding CanCancel}" />
                            </Grid>

                            <Grid
                                x:Name="NetworkSection"
                                ColumnSpacing="14"
                                RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="AnalysisProgressColumn0" Width="*" />
                                    <ColumnDefinition x:Name="AnalysisProgressColumn1" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    x:Name="AnalysisStepsPanel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="8">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Identification steps" />
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <ItemsControl ItemsSource="{Binding IdentificationSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:IdentificationStepUpdate">
                                                    <Grid Padding="8,6" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind StatusGlyph}" />
                                                        <StackPanel Grid.Column="1" MinWidth="0" Spacing="1">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind Title}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Opacity="0.7"
                                                                Text="{x:Bind Detail}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Opacity="0.75"
                                                            Text="{x:Bind StatusDisplay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <StackPanel
                                    x:Name="NetworkCallsPanel"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="8">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Network calls" />
                                    <Border
                                        x:Name="NetworkActivityBorder"
                                        Height="420"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <ListView
                                            x:Name="NetworkActivityList"
                                            Padding="4"
                                            HorizontalContentAlignment="Stretch"
                                            IsItemClickEnabled="False"
                                            ItemsSource="{Binding NetworkActivities}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.HorizontalScrollMode="Disabled"
                                            SelectionMode="None">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="8,6" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:NetworkActivity">
                                                    <Grid MinWidth="0" RowSpacing="3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind Category}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Opacity="0.75"
                                                                Text="{x:Bind StatusDisplay}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                Opacity="0.65"
                                                                Text="{x:Bind TimeDisplay}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Text="{x:Bind Message}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            MaxLines="3"
                                                            Opacity="0.7"
                                                            Text="{x:Bind DisplayUrl}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            Spacing="12"
                            Visibility="{Binding IsStreamStepActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Step 3: Select stream" />
                            <TextBlock Text="Detected manifest / media API" />
                            <TextBox
                                HorizontalAlignment="Stretch"
                                IsReadOnly="True"
                                Text="{Binding DetectedStreamUrl, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="Quality" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Label"
                                IsEnabled="{Binding CanConfigureDownload}"
                                ItemsSource="{Binding AvailableQualities}"
                                SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" />
                            <TextBlock FontWeight="SemiBold" Text="AI diagnostic" />
                            <TextBlock
                                Opacity="0.75"
                                Text="{Binding AiDiagnostic}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="Request context passed to FFmpeg" />
                            <TextBox
                                MinHeight="76"
                                AcceptsReturn="True"
                                HorizontalAlignment="Stretch"
                                IsReadOnly="True"
                                Text="{Binding RequestContextDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding GoToAnalyzeStepCommand}"
                                    Content="Back" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding GoToDownloadStepCommand}"
                                    Content="Continue"
                                    IsEnabled="{Binding CanGoToDownloadStep}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            Spacing="12"
                            Visibility="{Binding IsDownloadStepActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Step 4: Download options" />
                            <TextBlock Text="FFmpeg input API" />
                            <TextBox
                                HorizontalAlignment="Stretch"
                                IsReadOnly="True"
                                Text="{Binding DownloadApiUrl, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="Output file" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding CanConfigureDownload}"
                                Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding BrowseOutputCommand}"
                                    Content="Browse"
                                    IsEnabled="{Binding CanConfigureDownload}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding GoToStreamStepCommand}"
                                    Content="Back" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding DownloadCommand}"
                                    Content="Start download"
                                    IsEnabled="{Binding CanDownload}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            Spacing="12"
                            Visibility="{Binding IsDownloadProgressStepActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Step 5: Download progress" />
                            <TextBlock Text="{Binding OutputPath}" TextWrapping="Wrap" />

                            <Grid x:Name="ActionGrid" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ActionColumn0" Width="*" />
                                    <ColumnDefinition x:Name="ActionColumn1" Width="*" />
                                    <ColumnDefinition x:Name="ActionColumn2" Width="*" />
                                    <ColumnDefinition x:Name="ActionColumn3" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    x:Name="DownloadButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Command="{Binding DownloadCommand}"
                                    Content="Restart"
                                    IsEnabled="{Binding CanDownload}" />
                                <Button
                                    x:Name="PauseButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding PauseCommand}"
                                    Content="Pause"
                                    IsEnabled="{Binding CanPause}" />
                                <Button
                                    x:Name="ResumeButton"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Command="{Binding ResumeCommand}"
                                    Content="Resume"
                                    IsEnabled="{Binding CanResume}" />
                                <Button
                                    x:Name="CancelButton"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Command="{Binding CancelCommand}"
                                    Content="Cancel"
                                    IsEnabled="{Binding CanCancel}" />
                            </Grid>

                            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Progress" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageDisplay}" />
                            </Grid>
                            <ProgressBar
                                Height="16"
                                HorizontalAlignment="Stretch"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding ProgressPercentage}" />
                            <VariableSizedWrapGrid MaximumRowsOrColumns="2" Orientation="Horizontal">
                                <TextBlock MinWidth="220" Text="{Binding DownloadedBytesDisplay}" TextWrapping="Wrap" />
                                <TextBlock MinWidth="220" Text="{Binding DownloadSpeed}" TextWrapping="Wrap" />
                                <TextBlock MinWidth="220" Text="{Binding ElapsedTime}" TextWrapping="Wrap" />
                                <TextBlock MinWidth="220" Text="{Binding EstimatedTime}" TextWrapping="Wrap" />
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
