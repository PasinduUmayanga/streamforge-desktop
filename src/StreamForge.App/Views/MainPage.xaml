<Page
    x:Class="StreamForge.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StreamForge.Core.Models">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentContainer.Padding" Value="12" />
                        <Setter Target="MainColumn0.Width" Value="*" />
                        <Setter Target="MainColumn1.Width" Value="0" />
                        <Setter Target="AnalysisSection.(Grid.Row)" Value="0" />
                        <Setter Target="AnalysisSection.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadSection.(Grid.Row)" Value="1" />
                        <Setter Target="DownloadSection.(Grid.Column)" Value="0" />

                        <Setter Target="OutputPathTextBox.(Grid.Row)" Value="0" />
                        <Setter Target="OutputPathTextBox.(Grid.Column)" Value="0" />
                        <Setter Target="OutputPathTextBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BrowseButton.(Grid.Row)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.Column)" Value="0" />
                        <Setter Target="BrowseButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BrowseButton.HorizontalAlignment" Value="Stretch" />

                        <Setter Target="ActionColumn0.Width" Value="*" />
                        <Setter Target="ActionColumn1.Width" Value="0" />
                        <Setter Target="ActionColumn2.Width" Value="0" />
                        <Setter Target="ActionColumn3.Width" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Row)" Value="1" />
                        <Setter Target="PauseButton.(Grid.Column)" Value="0" />
                        <Setter Target="ResumeButton.(Grid.Row)" Value="2" />
                        <Setter Target="ResumeButton.(Grid.Column)" Value="0" />
                        <Setter Target="CancelButton.(Grid.Row)" Value="3" />
                        <Setter Target="CancelButton.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PauseButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ResumeButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CancelButton.HorizontalAlignment" Value="Stretch" />

                        <Setter Target="MetricColumn0.Width" Value="*" />
                        <Setter Target="MetricColumn1.Width" Value="0" />
                        <Setter Target="DownloadedMetric.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedMetric.(Grid.Row)" Value="1" />
                        <Setter Target="SpeedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="ElapsedMetric.(Grid.Row)" Value="2" />
                        <Setter Target="ElapsedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="EstimatedMetric.(Grid.Row)" Value="3" />
                        <Setter Target="EstimatedMetric.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentContainer.Padding" Value="20" />
                        <Setter Target="MainColumn0.Width" Value="*" />
                        <Setter Target="MainColumn1.Width" Value="0" />
                        <Setter Target="AnalysisSection.(Grid.Row)" Value="0" />
                        <Setter Target="AnalysisSection.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadSection.(Grid.Row)" Value="1" />
                        <Setter Target="DownloadSection.(Grid.Column)" Value="0" />

                        <Setter Target="OutputPathTextBox.(Grid.Row)" Value="0" />
                        <Setter Target="OutputPathTextBox.(Grid.Column)" Value="0" />
                        <Setter Target="OutputPathTextBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.Row)" Value="0" />
                        <Setter Target="BrowseButton.(Grid.Column)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseButton.HorizontalAlignment" Value="Left" />

                        <Setter Target="ActionColumn0.Width" Value="*" />
                        <Setter Target="ActionColumn1.Width" Value="*" />
                        <Setter Target="ActionColumn2.Width" Value="0" />
                        <Setter Target="ActionColumn3.Width" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Row)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Column)" Value="1" />
                        <Setter Target="ResumeButton.(Grid.Row)" Value="1" />
                        <Setter Target="ResumeButton.(Grid.Column)" Value="0" />
                        <Setter Target="CancelButton.(Grid.Row)" Value="1" />
                        <Setter Target="CancelButton.(Grid.Column)" Value="1" />
                        <Setter Target="DownloadButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PauseButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ResumeButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CancelButton.HorizontalAlignment" Value="Stretch" />

                        <Setter Target="MetricColumn0.Width" Value="*" />
                        <Setter Target="MetricColumn1.Width" Value="*" />
                        <Setter Target="DownloadedMetric.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedMetric.(Grid.Row)" Value="0" />
                        <Setter Target="SpeedMetric.(Grid.Column)" Value="1" />
                        <Setter Target="ElapsedMetric.(Grid.Row)" Value="1" />
                        <Setter Target="ElapsedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="EstimatedMetric.(Grid.Row)" Value="1" />
                        <Setter Target="EstimatedMetric.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentContainer.Padding" Value="28" />
                        <Setter Target="MainColumn0.Width" Value="*" />
                        <Setter Target="MainColumn1.Width" Value="*" />
                        <Setter Target="AnalysisSection.(Grid.Row)" Value="0" />
                        <Setter Target="AnalysisSection.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadSection.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadSection.(Grid.Column)" Value="1" />

                        <Setter Target="OutputPathTextBox.(Grid.Row)" Value="0" />
                        <Setter Target="OutputPathTextBox.(Grid.Column)" Value="0" />
                        <Setter Target="OutputPathTextBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.Row)" Value="0" />
                        <Setter Target="BrowseButton.(Grid.Column)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseButton.HorizontalAlignment" Value="Left" />

                        <Setter Target="ActionColumn0.Width" Value="Auto" />
                        <Setter Target="ActionColumn1.Width" Value="Auto" />
                        <Setter Target="ActionColumn2.Width" Value="Auto" />
                        <Setter Target="ActionColumn3.Width" Value="Auto" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Row)" Value="0" />
                        <Setter Target="PauseButton.(Grid.Column)" Value="1" />
                        <Setter Target="ResumeButton.(Grid.Row)" Value="0" />
                        <Setter Target="ResumeButton.(Grid.Column)" Value="2" />
                        <Setter Target="CancelButton.(Grid.Row)" Value="0" />
                        <Setter Target="CancelButton.(Grid.Column)" Value="3" />
                        <Setter Target="DownloadButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="PauseButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="ResumeButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="CancelButton.HorizontalAlignment" Value="Left" />

                        <Setter Target="MetricColumn0.Width" Value="*" />
                        <Setter Target="MetricColumn1.Width" Value="*" />
                        <Setter Target="DownloadedMetric.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedMetric.(Grid.Row)" Value="0" />
                        <Setter Target="SpeedMetric.(Grid.Column)" Value="1" />
                        <Setter Target="ElapsedMetric.(Grid.Row)" Value="1" />
                        <Setter Target="ElapsedMetric.(Grid.Column)" Value="0" />
                        <Setter Target="EstimatedMetric.(Grid.Row)" Value="1" />
                        <Setter Target="EstimatedMetric.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalContentAlignment="Top"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <Grid
                x:Name="ContentContainer"
                Width="{Binding ElementName=PageScrollViewer, Path=ViewportWidth}"
                MaxWidth="1200"
                Padding="28"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,22"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="StreamForge" />

                <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnSpacing="28" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MainColumn0" Width="*" />
                        <ColumnDefinition x:Name="MainColumn1" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        x:Name="AnalysisSection"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinWidth="0"
                        Spacing="12">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Analyze video" />

                        <TextBlock Text="Video Page URL" />
                        <TextBox
                            HorizontalAlignment="Stretch"
                            Text="{Binding PageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="https://example.com/video/123" />

                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding AnalyzeCommand}"
                            Content="Analyze"
                            IsEnabled="{Binding CanAnalyze}" />

                        <Grid Margin="0,4,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Network analysis" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                IsActive="{Binding IsAnalyzing}" />
                        </Grid>
                        <TextBlock
                            Margin="0,-8,0,0"
                            Opacity="0.7"
                            Text="Relevant page, fetch, XHR, and media requests appear here. Query values are hidden."
                            TextWrapping="Wrap" />
                        <Border
                            Height="210"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ListView
                                x:Name="NetworkActivityList"
                                Padding="4"
                                IsItemClickEnabled="False"
                                ItemsSource="{Binding NetworkActivities}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:NetworkActivity">
                                        <Grid Padding="2,5" ColumnSpacing="8" RowSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Opacity="0.65"
                                                Text="{x:Bind TimeDisplay}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Category}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Opacity="0.75"
                                                Text="{x:Bind StatusDisplay}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Text="{x:Bind Message}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="3"
                                                Opacity="0.7"
                                                Text="{x:Bind DisplayUrl}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="Status" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,4,0,0" Text="Detected manifest / media API" />
                        <TextBox
                            HorizontalAlignment="Stretch"
                            IsReadOnly="True"
                            Text="{Binding DetectedStreamUrl, Mode=OneWay}" />

                        <TextBlock Text="Quality" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding AvailableQualities}"
                            SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="DownloadSection"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="0"
                        Spacing="12">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Download" />

                        <TextBlock Text="FFmpeg input API (selected quality)" />
                        <TextBox
                            HorizontalAlignment="Stretch"
                            IsReadOnly="True"
                            Text="{Binding DownloadApiUrl, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="Request context passed to FFmpeg" />
                        <TextBox
                            MinHeight="76"
                            AcceptsReturn="True"
                            HorizontalAlignment="Stretch"
                            IsReadOnly="True"
                            Text="{Binding RequestContextDisplay, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="Output file" />
                        <Grid x:Name="OutputGrid" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="OutputPathTextBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Name="BrowseButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding BrowseOutputCommand}"
                                Content="Browse" />
                        </Grid>

                        <Grid x:Name="ActionGrid" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ActionColumn0" Width="Auto" />
                                <ColumnDefinition x:Name="ActionColumn1" Width="Auto" />
                                <ColumnDefinition x:Name="ActionColumn2" Width="Auto" />
                                <ColumnDefinition x:Name="ActionColumn3" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                x:Name="DownloadButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding DownloadCommand}"
                                Content="Download"
                                IsEnabled="{Binding CanDownload}" />
                            <Button
                                x:Name="PauseButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding PauseCommand}"
                                Content="Pause"
                                IsEnabled="{Binding CanPause}" />
                            <Button
                                x:Name="ResumeButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Command="{Binding ResumeCommand}"
                                Content="Resume"
                                IsEnabled="{Binding CanResume}" />
                            <Button
                                x:Name="CancelButton"
                                Grid.Row="0"
                                Grid.Column="3"
                                Command="{Binding CancelCommand}"
                                Content="Cancel" />
                        </Grid>

                        <Grid Margin="0,8,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Progress" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageDisplay}" />
                        </Grid>
                        <ProgressBar
                            Height="16"
                            HorizontalAlignment="Stretch"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ProgressPercentage}" />

                        <Grid x:Name="MetricsGrid" ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MetricColumn0" Width="*" />
                                <ColumnDefinition x:Name="MetricColumn1" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="DownloadedMetric"
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding DownloadedBytesDisplay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SpeedMetric"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding DownloadSpeed}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ElapsedMetric"
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding ElapsedTime}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="EstimatedMetric"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding EstimatedTime}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
