<Page
    x:Class="StreamForge.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StreamForge.Core.Models">
    <ScrollViewer>
        <StackPanel Spacing="14" Padding="28" MaxWidth="980" HorizontalAlignment="Stretch">
            <TextBlock Text="StreamForge" FontSize="32" FontWeight="SemiBold" />

            <TextBlock Text="Video Page URL" />
            <TextBox Text="{Binding PageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="https://example.com/video/123" />

            <Button Content="Analyze"
                    Command="{Binding AnalyzeCommand}"
                    IsEnabled="{Binding CanAnalyze}" />

            <TextBlock Text="Status:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />

            <TextBlock Text="Detected Stream" />
            <TextBox Text="{Binding DetectedStreamUrl, Mode=OneWay}" IsReadOnly="True" />

            <TextBlock Text="Quality" />
            <ComboBox ItemsSource="{Binding AvailableQualities}"
                      SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      MinWidth="240" />

            <TextBlock Text="Output" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Content="Browse"
                        Command="{Binding BrowseOutputCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Download"
                        Command="{Binding DownloadCommand}"
                        IsEnabled="{Binding CanDownload}" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}" />
            </StackPanel>

            <TextBlock Text="Progress" FontWeight="SemiBold" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercentage}"
                         Height="16" />

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DownloadedBytesDisplay}" />
                <TextBlock Grid.Column="1" Text="{Binding DownloadSpeed}" />
                <TextBlock Grid.Column="2" Text="{Binding ElapsedTime}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
